# HarnessWiki City — environment template. Copy to .env and fill in.
# Never commit .env (see .gitignore).

# Weights & Biases / Weave — required for tracing the generation loop.
WANDB_API_KEY=
WEAVE_PROJECT=harnesswiki-city

# Model provider for the Content Generator and Reward Critic.
ANTHROPIC_API_KEY=

# Optional: video/image generation (Seedance). Not required for the MVP loop.
SEEDANCE_API_KEY=
